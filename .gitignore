# Large media files (GitHub has strict 100MB per-file limits)
*.mp4
*.mov
*.webm
*.avi
*.mkv

# Large local media directories & python virtualenvs
PDP_Research_Board/
MP & PDP/
IM 2026 Analyisis/
uv_python/
output_reports/
HONASA TDC GSO/
IM/
tools/git/
tools/*.exe

# Python compilation & cache
**/__pycache__/
**/.pytest_cache/
**/.cache_im_agent/
*.pyc
*.pyo
*.pyd
*.log
*.ini

# Sensitive credentials & environment tokens (CRITICAL: Never leak API keys)
**/.env
.env.*

# Internal session metadata & temporary links
.system_generated/
LIVE_WEBSITE_LINK.txt

# Internal working spreadsheets with raw data
*.xlsx

# Node dependencies
node_modules/
**/node_modules/
honasa_audiocrm/node_modules/
honasa_audiocrm/audio-files/

